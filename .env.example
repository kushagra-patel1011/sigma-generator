# Copy to .env and adjust.  Every value is optional - the tool ships with
# working defaults and every setting can also be passed on the command line.
# Command-line flags win over environment variables, which win over defaults.

# --- ATT&CK data ------------------------------------------------------------
# Collection index used by `python -m src.main update` to discover the newest
# released Enterprise ATT&CK bundle.
ATTACK_INDEX_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/index.json

# Pin a specific bundle instead of resolving the newest one (optional).
# ATTACK_DATA_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-19.2.json

# Local cache location for the downloaded bundle.
ATTACK_DATA_PATH=data/enterprise-attack.json

# Seconds before an HTTP request to the ATT&CK mirror is abandoned.
ATTACK_HTTP_TIMEOUT=60

# --- SigmaHQ (gap analysis) -------------------------------------------------
# Local index built from SigmaHQ's release zip by `update`.
SIGMAHQ_INDEX_PATH=data/sigmahq-index.json
# Release asset to download; `latest` always resolves to the newest release.
SIGMAHQ_RELEASE_URL=https://github.com/SigmaHQ/sigma/releases/latest/download/sigma_all_rules.zip

# --- Rule defaults ----------------------------------------------------------
# Value written to the `author:` field of generated rules.
SIGMA_AUTHOR=sigma-generator
# One of: stable, test, experimental, deprecated, unsupported
SIGMA_STATUS=experimental
# Where rules and bundles are written.
SIGMA_OUTPUT_DIR=output

# --- STIX defaults ----------------------------------------------------------
# Identity name used as `created_by_ref` in the generated bundle.
STIX_IDENTITY_NAME=sigma-generator
# Traffic Light Protocol marking applied to bundle objects: white, green, amber, red
STIX_TLP=amber
